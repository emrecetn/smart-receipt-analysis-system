# Supabase project credentials (Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
# Service role key — bypasses Row Level Security, keep this secret, never expose it client-side
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# OpenAI API key with access to GPT-4o (Vision)
OPENAI_API_KEY=sk-your-openai-key
